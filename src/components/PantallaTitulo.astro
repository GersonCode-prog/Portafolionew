---
import { ruta } from '../utils';
import { jugador } from '../config';
---
<section class="titulo-pantalla">
  <div class="luna" aria-hidden="true"></div>
  <div class="anillo" aria-hidden="true"></div>

  <div class="contenedor contenido">
    <p class="kanji" aria-hidden="true">{jugador.nombreJapones}</p>
    <p class="presenta">— Dev Quest —</p>
    <h1 class="nombre" data-texto={jugador.nombre.split(' ')[0]}>{jugador.nombre.split(' ')[0]}</h1>
    <p class="subtitulo">
      <span class="dorado">◆</span> {jugador.clase} <span class="dorado">◆</span> Nivel {jugador.nivel}
    </p>

    <a href="#estado" class="press-start">▶ PRESS START ◀</a>

    <div class="menu-inicio">
      <a href="#estado" class="opcion"><span>▶</span> Nueva partida</a>
      <a href={ruta('/misiones')} class="opcion"><span>▶</span> Ver misiones</a>
      <a href={ruta('/contacto')} class="opcion"><span>▶</span> Unirse a la party</a>
    </div>
  </div>
</section>

<style>
  .titulo-pantalla { position: relative; min-height: 100vh; display: grid; place-items: center; text-align: center; padding: 7rem 0 4rem; overflow: hidden; }

  .luna {
    position: absolute; width: min(520px, 80vw); aspect-ratio: 1; border-radius: 50%;
    background: radial-gradient(circle at 35% 35%, #fff4d6, #ffcc4d 45%, #ff8a3d 75%, transparent 76%);
    opacity: .16; filter: blur(2px);
    animation: flotar 10s ease-in-out infinite;
  }
  .anillo {
    position: absolute; width: min(720px, 110vw); aspect-ratio: 1; border-radius: 50%;
    border: 1px dashed rgba(143, 140, 240, .35);
    animation: girar 60s linear infinite;
  }
  @keyframes flotar { 50% { transform: translateY(-20px); } }
  @keyframes girar { to { transform: rotate(360deg); } }

  .contenido { position: relative; }
  .kanji {
    font-family: var(--fuente-jp); font-weight: 900;
    font-size: clamp(3rem, 12vw, 8rem); line-height: 1;
    color: transparent; -webkit-text-stroke: 1px rgba(255, 95, 162, .45);
    letter-spacing: .1em; margin-bottom: -1.5rem;
  }
  .presenta { font-family: var(--fuente-mono); color: var(--rosa); letter-spacing: .4em; text-transform: uppercase; font-size: .85rem; position: relative; }

  .nombre {
    position: relative;
    font-size: clamp(4rem, 15vw, 10rem); font-weight: 700; font-style: italic;
    letter-spacing: .04em; line-height: 1;
    background: linear-gradient(180deg, #fff 0%, #ffe9a8 45%, #ffcc4d 55%, #f08a1c 100%);
    -webkit-background-clip: text; background-clip: text; color: transparent;
    filter: drop-shadow(0 4px 0 #7c2d12) drop-shadow(0 0 30px rgba(255, 204, 77, .45));
    margin: .5rem 0 1rem;
  }

  .subtitulo { font-family: var(--fuente-titulo); font-size: clamp(1rem, 2.5vw, 1.35rem); text-transform: uppercase; letter-spacing: .12em; color: var(--texto); margin-bottom: 3rem; }
  .dorado { color: var(--oro); }

  .press-start {
    display: inline-block; font-family: var(--fuente-titulo); font-weight: 700;
    font-size: clamp(1.1rem, 3vw, 1.6rem); letter-spacing: .25em; color: var(--oro);
    text-shadow: 0 0 15px rgba(255, 204, 77, .7);
    animation: parpadeo 1.2s steps(2) infinite; margin-bottom: 2.5rem;
  }
  @keyframes parpadeo { 50% { opacity: .15; } }

  .menu-inicio { display: flex; flex-direction: column; align-items: center; gap: .35rem; }
  .opcion { font-family: var(--fuente-titulo); font-weight: 700; text-transform: uppercase; letter-spacing: .1em; color: var(--texto-suave); padding: .3rem 1rem; transition: color .15s; }
  .opcion span { color: var(--oro); opacity: 0; margin-right: .3rem; transition: opacity .15s; }
  .opcion:hover { color: var(--texto); }
  .opcion:hover span { opacity: 1; }
</style>
